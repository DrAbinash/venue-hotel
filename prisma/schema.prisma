generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model HotelSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Floor {
  id          String   @id @default(cuid())
  name        String
  number      Int      @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rooms       Room[]
}

model Room {
  id            String   @id @default(cuid())
  name          String
  roomNumber    String   @unique
  floorId       String
  floor         Floor    @relation(fields: [floorId], references: [id])
  type          String   @default("Standard")
  basePrice     Float
  /// Number of identical units of this room type that can be sold in parallel.
  quantity      Int      @default(1)
  maxGuests     Int      @default(2)
  extraGuestFee Float    @default(0)
  bedType       String?
  size          String?
  view          String?
  description   String
  amenities     String   @default("[]")
  images        String   @default("[]")
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bookings      Booking[]
}

model Booking {
  id              String    @id @default(cuid())
  bookingRef      String    @unique
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id])
  guestName       String
  guestEmail      String
  guestPhone      String
  guestCountry    String?
  checkIn         DateTime
  checkOut        DateTime
  nights          Int       @default(1)
  adults          Int       @default(1)
  children        Int       @default(0)
  roomType        String
  currency        String    @default("INR")
  roomTotal       Float     @default(0)
  extraGuestTotal Float     @default(0)
  feeAmount       Float     @default(0)
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float
  amountPaid      Float     @default(0)
  /// pending | confirmed | checked_in | checked_out | cancelled | no_show
  status          String    @default("pending")
  /// unpaid | partial | paid | refunded | failed
  paymentStatus   String    @default("unpaid")
  /// razorpay | icici | payAtHotel | bankTransfer | manual
  paymentMethod   String?
  source          String    @default("website")
  specialRequests String?
  internalNotes   String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([guestEmail])
}

/// One ledger for every rupee taken, whether it paid for a room or a burger.
/// Exactly one of bookingId / orderId is set on any given row.
model Payment {
  id           String     @id @default(cuid())
  bookingId    String?
  booking      Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  orderId      String?
  order        FoodOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// razorpay | icici | manual
  gateway      String
  /// test | live
  mode           String   @default("test")
  /// Order id issued by the gateway (e.g. a Razorpay order).
  gatewayOrderId String?
  paymentId      String?
  signature      String?
  referenceNo  String?
  amount       Float
  currency     String   @default("INR")
  /// created | pending | paid | failed | refunded | cancelled
  status       String   @default("created")
  method       String?
  errorMessage String?
  rawPayload   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bookingId])
  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([referenceNo])
}

// ---------------------------------------------------------------------------
//  Restaurant
// ---------------------------------------------------------------------------

model MenuCategory {
  id          String     @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  /// Icon key rendered on the category rail (see MENU_ICONS in the UI).
  icon        String     @default("utensils")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]
}

model MenuItem {
  id           String       @id @default(cuid())
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String       @default("")
  imageUrl     String?
  basePrice    Float
  /// JSON: [{ "label": "Regular", "priceDelta": 0 }, { "label": "Large", "priceDelta": 60 }]
  sizes        String       @default("[]")
  /// JSON: [{ "label": "Extra Cheese", "price": 40 }]
  addons       String       @default("[]")
  isVeg        Boolean      @default(true)
  spiceLevel   Int          @default(0)
  calories     Int?
  prepMinutes  Int          @default(15)
  isAvailable  Boolean      @default(true)
  isBestseller Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId])
}

model FoodOrder {
  id             String          @id @default(cuid())
  orderRef       String          @unique
  /// dine_in | room_service | takeaway | delivery
  orderType      String          @default("dine_in")
  tableNumber    String?
  roomNumber     String?
  /// Links a room-service order to the guest's reservation.
  bookingRef     String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryAddress String?
  currency       String          @default("INR")
  subtotal       Float           @default(0)
  packagingFee   Float           @default(0)
  deliveryFee    Float           @default(0)
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  totalAmount    Float           @default(0)
  amountPaid     Float           @default(0)
  /// placed | accepted | preparing | ready | served | completed | cancelled
  status         String          @default("placed")
  /// unpaid | partial | paid | refunded | failed
  paymentStatus  String          @default("unpaid")
  paymentMethod  String?
  notes          String?
  scheduledFor   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          FoodOrderItem[]
  payments       Payment[]

  @@index([status])
  @@index([createdAt])
}

model FoodOrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  name       String
  size       String?
  unitPrice  Float
  quantity   Int       @default(1)
  /// JSON: [{ "label": "Extra Cheese", "price": 40 }]
  addons     String    @default("[]")
  lineTotal  Float
  notes      String?

  @@index([orderId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  filename  String   @unique
  url       String
  mimeType  String   @default("image/webp")
  size      Int      @default(0)
  width     Int?
  height    Int?
  folder    String   @default("general")
  alt       String?
  createdAt DateTime @default(now())

  @@index([folder])
}

model GalleryImage {
  id        String   @id @default(cuid())
  category  String   @default("general")
  url       String
  caption   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
